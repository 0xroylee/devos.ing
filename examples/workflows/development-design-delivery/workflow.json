  "steps": [
    {
      "id": "clarify",
      "title": "Clarify the product request one question at a time",
      "skill": "mattpocock:grilling"
    },
    {
      "id": "prototype",
      "title": "Prototype only the uncertain interface",
      "skill": "mattpocock:prototype",
      "gate": "human_approval"
    },
    {
      "id": "spec",
      "title": "Write the approved specification",
      "skill": "mattpocock:to-spec"
    },
    {
      "id": "plan",
      "title": "Slice the specification into vertical tickets",
      "skill": "mattpocock:to-tickets",
      "gate": "human_approval"
    },
    {
      "id": "implement",
      "title": "Implement the approved tickets",
      "skill": "mattpocock:implement",
      "phase": "implementation",
      "instruction": "Invoke only when commit permission is explicit; otherwise implement the approved ticket with mattpocock:tdd and do not commit."
    },
    {
      "id": "verify",
      "title": "Collect fresh verification evidence",
      "skill": "./skills/development-design-delivery"
    }
  ]
