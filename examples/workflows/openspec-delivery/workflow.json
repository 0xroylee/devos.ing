{
  "schemaVersion": "0.1",
  "name": "openspec-delivery",
  "version": "0.2.0",
  "description": "Deliver an approved OpenSpec change through design, vertical tickets, implementation, review, and archive.",
  "skills": [
    {
      "source": "./skills/openspec-delivery"
    },
    {
      "source": "./skills/opsx-handoff-review"
    },
    {
      "source": "mattpocock:codebase-design",
      "repo": "https://github.com/mattpocock/skills/tree/5b15a47f2d7150f545fbcacbfe381787fc0230dc"
    },
    {
      "source": "mattpocock:to-tickets",
      "repo": "https://github.com/mattpocock/skills/tree/5b15a47f2d7150f545fbcacbfe381787fc0230dc"
    },
    {
      "source": "mattpocock:implement",
      "repo": "https://github.com/mattpocock/skills/tree/5b15a47f2d7150f545fbcacbfe381787fc0230dc"
    },
    {
      "source": "mattpocock:tdd",
      "repo": "https://github.com/mattpocock/skills/tree/5b15a47f2d7150f545fbcacbfe381787fc0230dc"
    },
    {
      "source": "mattpocock:diagnosing-bugs",
      "repo": "https://github.com/mattpocock/skills/tree/5b15a47f2d7150f545fbcacbfe381787fc0230dc"
    },
    {
      "source": "mattpocock:code-review",
      "repo": "https://github.com/mattpocock/skills/tree/5b15a47f2d7150f545fbcacbfe381787fc0230dc"
    }
  ],
  "steps": [
    {
      "id": "opsx-propose",
      "title": "Create the OpenSpec proposal, specs, and tasks",
      "skill": "./skills/opsx-handoff-review"
    },
    {
      "id": "opsx-review",
      "title": "Approve the OpenSpec proposal",
      "skill": "./skills/opsx-handoff-review",
      "gate": "human_approval"
    },
    {
      "id": "design",
      "title": "Check the codebase boundary",
      "skill": "mattpocock:codebase-design"
    },
    {
      "id": "plan",
      "title": "Slice the approved scope into vertical tickets",
      "skill": "mattpocock:to-tickets",
      "gate": "human_approval"
    },
    {
      "id": "implement",
      "title": "Implement the approved tickets",
      "skill": "mattpocock:implement",
      "phase": "implementation",
      "instruction": "Invoke only when commit permission is explicit; otherwise implement the approved ticket with mattpocock:tdd and do not commit."
    },
    {
      "id": "opsx-archive",
      "title": "Archive the completed OpenSpec change",
      "skill": "./skills/opsx-handoff-review",
      "gate": "human_approval"
    }
  ]
}
