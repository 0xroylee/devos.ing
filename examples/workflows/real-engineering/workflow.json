    {
      "id": "command-discipline",
      "title": "Use the repository command wrapper",
      "skill": "./skills/rtk-command-discipline"
    },
    {
      "id": "clarify",
      "title": "Clarify the request one question at a time",
      "skill": "mattpocock:grilling",
